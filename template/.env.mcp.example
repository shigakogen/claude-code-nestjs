# Copy thành .env.mcp và nạp trước khi chạy claude (vd: `set -a; source .env.mcp; set +a; claude`).
# KHÔNG commit .env.mcp.

# GitLab nội bộ
GITLAB_API_URL=https://gitlab.cong-ty-cua-ban.vn/api/v4
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# DB local trong docker-compose (CHỈ local, không bao giờ trỏ tới staging/prod)
# PostgreSQL:
LOCAL_DB_DSN=postgres://app:app@localhost:5432/appdb
# MySQL:
# LOCAL_DB_DSN=mysql://app:app@localhost:3306/appdb
